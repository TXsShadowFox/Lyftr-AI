# LYFTR AI — local development environment
# Copy to .env and fill in real values. Never commit .env.

# --- Backend ---
DATABASE_URL=sqlite:///./data/app.db
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Comma-separated. At least two are required for /health to be ready.
# For real quota failover, the keys must have independent quotas
# (Gemini limits are per project, not per key).
LLM_API_KEYS=replace-with-key-1,replace-with-key-2
# Optional OpenAI-compatible gateway / local mock provider:
# LLM_API_BASE=http://127.0.0.1:9999/v1
LLM_TEMPERATURE=0.7
LLM_REQUEST_TIMEOUT=60
LLM_NUM_RETRIES=0
CACHE_ENABLED=true
# CACHE_TTL_SECONDS=3600
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_FAILURE_SIMULATION=true
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Frontend (Vite build-time) ---
# Browser-visible backend URL. For Docker local this stays localhost.
VITE_API_BASE_URL=http://localhost:8000
